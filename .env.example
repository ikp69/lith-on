# Contact form delivery (src/app/api/contact/route.ts), via Resend (https://resend.com).
# Copy to .env.local and fill in. Server-only: never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Lith-On website <website@lith-on.com>"
CONTACT_FROM_EMAIL=
# Where submissions go (comma-separated). Defaults to tech@lith-onbharat.com.
CONTACT_TO_EMAIL=
